generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?  @map("password_hash")
  name         String
  isStub       Boolean  @default(false) @map("is_stub")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdTeeTimes TeeTime[]        @relation("CreatedBy")
  memberships     TeeTimeMember[]  @relation("Member")
  addedMembers    TeeTimeMember[]  @relation("AddedBy")

  @@map("users")
}

model TeeTime {
  id        String   @id @default(uuid()) @db.Uuid
  course    String
  teeOffAt  DateTime @map("tee_off_at")
  partySize Int      @default(4) @map("party_size")
  lat       Float?
  lon       Float?
  notes     String?
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User            @relation("CreatedBy", fields: [createdBy], references: [id])
  members TeeTimeMember[]

  @@index([teeOffAt])
  @@map("tee_times")
}

model TeeTimeMember {
  id        String   @id @default(uuid()) @db.Uuid
  teeTimeId String   @map("tee_time_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  addedBy   String   @map("added_by") @db.Uuid
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  teeTime TeeTime @relation(fields: [teeTimeId], references: [id], onDelete: Cascade)
  user    User    @relation("Member", fields: [userId], references: [id])
  adder   User    @relation("AddedBy", fields: [addedBy], references: [id])

  @@unique([teeTimeId, userId])
  @@map("tee_time_members")
}
