generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BASIC
  ADMIN
  EVENT

  @@map("user_role")
}

enum TeeTimeType {
  TEE_TIME
  TOURNAMENT

  @@map("tee_time_type")
}

enum TournamentFormat {
  STROKE
  SCRAMBLE
  BEST_BALL
  MATCH_PLAY
  OTHER

  @@map("tournament_format")
}

enum EventStandingsMode {
  TEAM_CUMULATIVE
  INDIVIDUAL_POINTS

  @@map("event_standings_mode")
}

enum EventGameType {
  CLOSEST_TO_PIN
  LONG_DRIVE
  CUSTOM

  @@map("event_game_type")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String    @map("password_hash")
  name               String
  role               UserRole  @default(BASIC)
  lastLoginAt        DateTime? @map("last_login_at")
  calendarFeedToken  String?   @unique @map("calendar_feed_token")
  weeknightDefault   String?   @map("weeknight_default")
  weekendDefault     String?   @map("weekend_default")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  createdTeeTimes     TeeTime[]               @relation("CreatedBy")
  memberships         TeeTimeMember[]         @relation("Member")
  addedMembers        TeeTimeMember[]         @relation("AddedBy")
  addedGuests         Guest[]                 @relation("GuestAddedBy")
  resetTokens         PasswordResetToken[]
  emailActionTokens   EmailActionToken[]
  notificationPrefs   NotificationPreference?
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  feedback            Feedback[]
  createdEvents       Event[]                 @relation("EventCreatedBy")
  eventParticipations EventParticipant[]      @relation("EventParticipantUser")
  enteredScores       EventScore[]            @relation("ScoreEnteredBy")

  @@map("users")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  url         String
  readAt      DateTime? @map("read_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("feedback")
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  body        String
  url         String?
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([publishedAt])
  @@map("announcements")
}

model NotificationPreference {
  userId           String   @id @map("user_id") @db.Uuid
  reminders        Boolean  @default(true)
  addedTo          Boolean  @default(true) @map("added_to")
  joinedByOther    Boolean  @default(true) @map("joined_by_other")
  leftByOther      Boolean  @default(true) @map("left_by_other")
  newTeeTime       Boolean  @default(true) @map("new_tee_time")
  unsubscribedAll  Boolean  @default(false) @map("unsubscribed_all")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model EmailActionToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  action    String
  teeTimeId String?   @map("tee_time_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teeTimeId])
  @@map("email_action_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Guest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  addedBy   String   @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adder           User            @relation("GuestAddedBy", fields: [addedBy], references: [id])
  teeTimeMembers  TeeTimeMember[] @relation("GuestMembership")

  @@map("guests")
}

model TeeTime {
  id             String            @id @default(uuid()) @db.Uuid
  course         String
  name           String?
  teeOffAt       DateTime          @map("tee_off_at")
  partySize      Int?              @map("party_size")
  teamSize       Int?              @map("team_size")
  type           TeeTimeType       @default(TEE_TIME)
  externalUrl    String?           @map("external_url")
  signupDeadline DateTime?         @map("signup_deadline")
  rangeOpensTime String?           @map("range_opens_time")
  isShotgun      Boolean           @default(false) @map("is_shotgun")
  format         TournamentFormat? @map("format")
  entryFee       Decimal?          @db.Decimal(10, 2) @map("entry_fee")
  lat            Float?
  lon            Float?
  notes          String?
  eventRoundId   String?           @map("event_round_id") @db.Uuid
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  creator    User        @relation("CreatedBy", fields: [createdBy], references: [id])
  members    TeeTimeMember[]
  eventRound EventRound? @relation(fields: [eventRoundId], references: [id], onDelete: SetNull)

  @@index([teeOffAt])
  @@index([eventRoundId])
  @@map("tee_times")
}

model TeeTimeMember {
  id         String    @id @default(uuid()) @db.Uuid
  teeTimeId  String    @map("tee_time_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  guestId    String?   @map("guest_id") @db.Uuid
  addedBy    String    @map("added_by") @db.Uuid
  confirmed  Boolean   @default(false)
  remindedAt DateTime? @map("reminded_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  teeTime TeeTime @relation(fields: [teeTimeId], references: [id], onDelete: Cascade)
  user    User?   @relation("Member", fields: [userId], references: [id])
  guest   Guest?  @relation("GuestMembership", fields: [guestId], references: [id], onDelete: Cascade)
  adder   User    @relation("AddedBy", fields: [addedBy], references: [id])

  @@unique([teeTimeId, userId])
  @@unique([teeTimeId, guestId])
  @@map("tee_time_members")
}

model Event {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  location      String?
  rules         String?
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  standingsMode EventStandingsMode @default(TEAM_CUMULATIVE) @map("standings_mode")
  createdBy     String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  creator      User               @relation("EventCreatedBy", fields: [createdBy], references: [id])
  teams        EventTeam[]
  participants EventParticipant[]
  rounds       EventRound[]
  games        EventGame[]

  @@index([startDate])
  @@map("events")
}

model EventTeam {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  color     String?
  seq       Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members         EventParticipant[]
  roundOverrides  EventRoundPlayer[] @relation("RoundTeamOverride")
  scores          EventScore[]
  gamesWon        EventGame[]        @relation("GameWinnerTeam")

  @@unique([eventId, name])
  @@map("event_teams")
}

model EventParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  teamId    String?  @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User               @relation("EventParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  team       EventTeam?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roundRows  EventRoundPlayer[]
  gamesWon   EventGame[]        @relation("GameWinnerParticipant")

  @@unique([eventId, userId])
  @@map("event_participants")
}

model EventRound {
  id        String            @id @default(uuid()) @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  seq       Int
  name      String?
  format    TournamentFormat?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teeTimes TeeTime[]
  scores   EventScore[]
  players  EventRoundPlayer[]
  games    EventGame[]

  @@unique([eventId, seq])
  @@map("event_rounds")
}

// One row per participant per round: team override for rotating-team
// formats (null = inherit EventParticipant.teamId) + rule tracking.
model EventRoundPlayer {
  id            String   @id @default(uuid()) @db.Uuid
  roundId       String   @map("round_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  teamId        String?  @map("team_id") @db.Uuid
  mulliFront    Boolean  @default(false) @map("mulli_front")
  mulliBack     Boolean  @default(false) @map("mulli_back")
  driveUsed     Boolean  @default(false) @map("drive_used")
  updatedAt     DateTime @updatedAt @map("updated_at")

  round       EventRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        EventTeam?       @relation("RoundTeamOverride", fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([roundId, participantId])
  @@map("event_round_players")
}

model EventScore {
  id        String   @id @default(uuid()) @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  front9    Int?     @map("front_9")
  back9     Int?     @map("back_9")
  enteredBy String   @map("entered_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  round   EventRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team    EventTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  enterer User       @relation("ScoreEnteredBy", fields: [enteredBy], references: [id])

  @@unique([roundId, teamId])
  @@map("event_scores")
}

model EventGame {
  id                   String        @id @default(uuid()) @db.Uuid
  eventId              String        @map("event_id") @db.Uuid
  roundId              String?       @map("round_id") @db.Uuid
  type                 EventGameType @default(CUSTOM)
  name                 String
  hole                 Int?
  winnerParticipantId  String?       @map("winner_participant_id") @db.Uuid
  winnerTeamId         String?       @map("winner_team_id") @db.Uuid
  payoutNote           String?       @map("payout_note")
  points               Int?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round             EventRound?       @relation(fields: [roundId], references: [id], onDelete: SetNull)
  winnerParticipant EventParticipant? @relation("GameWinnerParticipant", fields: [winnerParticipantId], references: [id], onDelete: SetNull)
  winnerTeam        EventTeam?        @relation("GameWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)

  @@map("event_games")
}

model EmailLog {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  kind      String   @default("other")
  status    String // SENT | FAILED
  error     String?
  attempts  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("email_log")
}
