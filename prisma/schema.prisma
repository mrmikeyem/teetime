generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BASIC
  ADMIN
  EVENT

  @@map("user_role")
}

enum TeeTimeType {
  TEE_TIME
  TOURNAMENT
  SIM

  @@map("tee_time_type")
}

// Only set on SIM tee times at a HOSTED venue (someone's house): PENDING =
// waiting on the host, CONFIRMED = on, CANCELLED = host said not this time.
// Null everywhere else (a public venue / regular tee time is simply "on").
enum SimNightStatus {
  PENDING
  CONFIRMED
  CANCELLED

  @@map("sim_night_status")
}

enum TournamentFormat {
  STROKE
  SCRAMBLE
  BEST_BALL
  MATCH_PLAY
  OTHER

  @@map("tournament_format")
}

enum EventStandingsMode {
  TEAM_CUMULATIVE
  INDIVIDUAL_POINTS

  @@map("event_standings_mode")
}

enum SimTallyMode {
  ADDITIVE
  MULTIPLIER

  @@map("sim_tally_mode")
}

enum EventGameType {
  CLOSEST_TO_PIN
  LONG_DRIVE
  CUSTOM

  @@map("event_game_type")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  email              String?   @unique
  phone              String?   @unique
  passwordHash       String    @map("password_hash")
  name               String
  role               UserRole  @default(BASIC)
  lastLoginAt        DateTime? @map("last_login_at")
  calendarFeedToken  String?   @unique @map("calendar_feed_token")
  weeknightDefault   String?   @map("weeknight_default")
  weekendDefault     String?   @map("weekend_default")
  simAccess          Boolean   @default(true) @map("sim_access")
  simTheme           String?   @map("sim_theme")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  createdTeeTimes     TeeTime[]               @relation("CreatedBy")
  memberships         TeeTimeMember[]         @relation("Member")
  addedMembers        TeeTimeMember[]         @relation("AddedBy")
  addedGuests         Guest[]                 @relation("GuestAddedBy")
  resetTokens         PasswordResetToken[]
  emailActionTokens   EmailActionToken[]
  notificationPrefs   NotificationPreference?
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  feedback            Feedback[]
  createdEvents       Event[]                 @relation("EventCreatedBy")
  eventParticipations EventParticipant[]      @relation("EventParticipantUser")
  enteredScores       EventScore[]            @relation("ScoreEnteredBy")
  simPlayer           SimPlayer?
  simPlaysLogged      SimPlay[]               @relation("SimPlayLoggedBy")
  hostedSimVenues     SimVenue[]              @relation("SimVenueHost")

  @@map("users")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  url         String
  readAt      DateTime? @map("read_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Feedback {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("feedback")
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  body        String
  url         String?
  publishedAt DateTime @default(now()) @map("published_at")

  @@index([publishedAt])
  @@map("announcements")
}

model NotificationPreference {
  userId           String   @id @map("user_id") @db.Uuid
  reminders        Boolean  @default(true)
  addedTo          Boolean  @default(true) @map("added_to")
  joinedByOther    Boolean  @default(true) @map("joined_by_other")
  leftByOther      Boolean  @default(true) @map("left_by_other")
  newTeeTime       Boolean  @default(true) @map("new_tee_time")
  unsubscribedAll  Boolean  @default(false) @map("unsubscribed_all")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model EmailActionToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  action    String
  teeTimeId String?   @map("tee_time_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teeTimeId])
  @@map("email_action_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Guest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  addedBy   String   @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adder           User            @relation("GuestAddedBy", fields: [addedBy], references: [id])
  teeTimeMembers  TeeTimeMember[] @relation("GuestMembership")
  simPlayer       SimPlayer?

  @@map("guests")
}

model TeeTime {
  id             String            @id @default(uuid()) @db.Uuid
  course         String
  name           String?
  teeOffAt       DateTime          @map("tee_off_at")
  partySize      Int?              @map("party_size")
  teamSize       Int?              @map("team_size")
  type           TeeTimeType       @default(TEE_TIME)
  externalUrl    String?           @map("external_url")
  signupDeadline DateTime?         @map("signup_deadline")
  rangeOpensTime String?           @map("range_opens_time")
  isShotgun      Boolean           @default(false) @map("is_shotgun")
  format         TournamentFormat? @map("format")
  entryFee       Decimal?          @db.Decimal(10, 2) @map("entry_fee")
  lat            Float?
  lon            Float?
  notes          String?
  eventRoundId   String?           @map("event_round_id") @db.Uuid
  simVenueId     String?           @map("sim_venue_id") @db.Uuid
  simStatus      SimNightStatus?   @map("sim_status")
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  creator    User        @relation("CreatedBy", fields: [createdBy], references: [id])
  members    TeeTimeMember[]
  eventRound EventRound? @relation(fields: [eventRoundId], references: [id], onDelete: SetNull)
  simVenue   SimVenue?   @relation(fields: [simVenueId], references: [id])

  @@index([teeOffAt])
  @@index([eventRoundId])
  @@index([simVenueId, teeOffAt])
  @@map("tee_times")
}

// A simulator venue for SIM tee times. With a host (a member's garage), every
// night there is the host's call: others' requests start PENDING, and the
// optional standing night is auto-proposed each Monday for the host to OK.
// Without a host (Albatros) it books like a normal course.
model SimVenue {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  hostUserId   String?  @map("host_user_id") @db.Uuid
  // Standing weekly night in America/Chicago: 0=Sun..6=Sat + "HH:MM".
  standingDay  Int?     @map("standing_day")
  standingTime String?  @map("standing_time")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  host     User?     @relation("SimVenueHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  teeTimes TeeTime[]

  @@map("sim_venues")
}

model TeeTimeMember {
  id         String    @id @default(uuid()) @db.Uuid
  teeTimeId  String    @map("tee_time_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  guestId    String?   @map("guest_id") @db.Uuid
  addedBy    String    @map("added_by") @db.Uuid
  confirmed  Boolean   @default(false)
  remindedAt DateTime? @map("reminded_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  teeTime TeeTime @relation(fields: [teeTimeId], references: [id], onDelete: Cascade)
  user    User?   @relation("Member", fields: [userId], references: [id])
  guest   Guest?  @relation("GuestMembership", fields: [guestId], references: [id], onDelete: Cascade)
  adder   User    @relation("AddedBy", fields: [addedBy], references: [id])

  @@unique([teeTimeId, userId])
  @@unique([teeTimeId, guestId])
  @@map("tee_time_members")
}

model Event {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  location      String?
  rules         String?
  startDate     DateTime           @map("start_date") @db.Date
  endDate       DateTime           @map("end_date") @db.Date
  standingsMode EventStandingsMode @default(TEAM_CUMULATIVE) @map("standings_mode")
  createdBy     String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  creator      User               @relation("EventCreatedBy", fields: [createdBy], references: [id])
  teams        EventTeam[]
  participants EventParticipant[]
  rounds       EventRound[]
  games        EventGame[]

  @@index([startDate])
  @@map("events")
}

model EventTeam {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  color     String?
  seq       Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  event           Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members         EventParticipant[]
  roundOverrides  EventRoundPlayer[] @relation("RoundTeamOverride")
  scores          EventScore[]
  gamesWon        EventGame[]        @relation("GameWinnerTeam")

  @@unique([eventId, name])
  @@map("event_teams")
}

model EventParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  teamId    String?  @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User               @relation("EventParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  team       EventTeam?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  roundRows  EventRoundPlayer[]
  gamesWon   EventGame[]        @relation("GameWinnerParticipant")

  @@unique([eventId, userId])
  @@map("event_participants")
}

model EventRound {
  id        String            @id @default(uuid()) @db.Uuid
  eventId   String            @map("event_id") @db.Uuid
  seq       Int
  name      String?
  format    TournamentFormat?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teeTimes TeeTime[]
  scores   EventScore[]
  players  EventRoundPlayer[]
  games    EventGame[]

  @@unique([eventId, seq])
  @@map("event_rounds")
}

// One row per participant per round: team override for rotating-team
// formats (null = inherit EventParticipant.teamId) + rule tracking.
model EventRoundPlayer {
  id            String   @id @default(uuid()) @db.Uuid
  roundId       String   @map("round_id") @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  teamId        String?  @map("team_id") @db.Uuid
  mulliFront    Boolean  @default(false) @map("mulli_front")
  mulliBack     Boolean  @default(false) @map("mulli_back")
  driveUsed     Boolean  @default(false) @map("drive_used")
  updatedAt     DateTime @updatedAt @map("updated_at")

  round       EventRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team        EventTeam?       @relation("RoundTeamOverride", fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([roundId, participantId])
  @@map("event_round_players")
}

model EventScore {
  id        String   @id @default(uuid()) @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  front9    Int?     @map("front_9")
  back9     Int?     @map("back_9")
  enteredBy String   @map("entered_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  round   EventRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team    EventTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  enterer User       @relation("ScoreEnteredBy", fields: [enteredBy], references: [id])

  @@unique([roundId, teamId])
  @@map("event_scores")
}

model EventGame {
  id                   String        @id @default(uuid()) @db.Uuid
  eventId              String        @map("event_id") @db.Uuid
  roundId              String?       @map("round_id") @db.Uuid
  type                 EventGameType @default(CUSTOM)
  name                 String
  hole                 Int?
  winnerParticipantId  String?       @map("winner_participant_id") @db.Uuid
  winnerTeamId         String?       @map("winner_team_id") @db.Uuid
  payoutNote           String?       @map("payout_note")
  points               Int?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round             EventRound?       @relation(fields: [roundId], references: [id], onDelete: SetNull)
  winnerParticipant EventParticipant? @relation("GameWinnerParticipant", fields: [winnerParticipantId], references: [id], onDelete: SetNull)
  winnerTeam        EventTeam?        @relation("GameWinnerTeam", fields: [winnerTeamId], references: [id], onDelete: SetNull)

  @@map("event_games")
}

model EmailLog {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  kind      String   @default("other")
  status    String // SENT | FAILED
  error     String?
  attempts  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("email_log")
}

// ── Sim wheel (winter simulator course picker, /sim) ─────────────────────

// Canonical course — one row per real course, shared by every player's list
// and the play log, so combined slices and "last played" key on the id.
model SimCourse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  // GolfCourseAPI id (opaque string; numeric = legacy id from the old app).
  apiId     String?  @unique @map("api_id")
  city      String?
  state     String?
  country   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listEntries SimListEntry[]
  plays       SimPlay[]

  @@map("sim_courses")
}

// A wheel participant: a member OR a guest (exactly one — CHECK constraint
// in the migration, same pattern as tee_time_members). `checked` = playing
// tonight; it's shared state, like the old app.
model SimPlayer {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @unique @map("user_id") @db.Uuid
  guestId    String?   @unique @map("guest_id") @db.Uuid
  checked    Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user  User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest Guest?          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  list  SimListEntry[]
  plays SimPlayPlayer[]

  @@map("sim_players")
}

// One course on one player's list; `position` is the drag order.
model SimListEntry {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  position  Int
  tally     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  player SimPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  course SimCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([playerId, courseId])
  @@index([playerId, position])
  @@map("sim_list_entries")
}

model SimPlay {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  playedAt  DateTime @map("played_at")
  // Logged without a time of day (manual entries) — display the date only.
  dateOnly  Boolean  @default(false) @map("date_only")
  // wheel | manual_play | manual_entry | import
  source    String   @default("wheel")
  teeName   String?  @map("tee_name")
  teeRating Decimal? @db.Decimal(4, 1) @map("tee_rating")
  teeSlope  Int?     @map("tee_slope")
  teeYards  Int?     @map("tee_yards")
  comment   String?
  loggedBy  String?  @map("logged_by") @db.Uuid
  // Id from the old app's data.json — keeps the one-off import idempotent.
  legacyId  String?  @unique @map("legacy_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course  SimCourse       @relation(fields: [courseId], references: [id])
  logger  User?           @relation("SimPlayLoggedBy", fields: [loggedBy], references: [id], onDelete: SetNull)
  players SimPlayPlayer[]

  @@index([playedAt])
  @@map("sim_plays")
}

// Who played a round, and who suggested it (several when a combined slice won).
model SimPlayPlayer {
  playId    String  @map("play_id") @db.Uuid
  playerId  String  @map("player_id") @db.Uuid
  played    Boolean @default(true)
  suggested Boolean @default(false)

  play   SimPlay   @relation(fields: [playId], references: [id], onDelete: Cascade)
  player SimPlayer @relation(fields: [playerId], references: [id])

  @@id([playId, playerId])
  @@map("sim_play_players")
}

// Singleton (id = 1): the group's shared wheel settings.
model SimSettings {
  id              Int          @id @default(1)
  courseLimit     Int          @default(0) @map("course_limit")
  tallyEnabled    Boolean      @default(false) @map("tally_enabled")
  tallyMode       SimTallyMode @default(ADDITIVE) @map("tally_mode")
  tallyMultiplier Decimal      @default(1.5) @db.Decimal(3, 1) @map("tally_multiplier")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("sim_settings")
}

// GolfCourseAPI course-detail cache (tees, ratings, holes).
model GolfCourseCache {
  apiId     String   @id @map("api_id")
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("golf_course_cache")
}
